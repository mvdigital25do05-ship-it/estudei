rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Global helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'activeProfileId', 'reminders', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.activeProfileId is string && data.activeProfileId.size() <= 128
        && data.reminders is list && data.reminders.size() <= 200
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['id', 'name'])
        && data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('disciplines' in data) || data.disciplines is list && data.disciplines.size() <= 100)
        && (!('mockTests' in data) || data.mockTests is list && data.mockTests.size() <= 100)
        && (!('exerciseLogs' in data) || data.exerciseLogs is list && data.exerciseLogs.size() <= 1000)
        && (!('activityLogs' in data) || data.activityLogs is list && data.activityLogs.size() <= 1000)
        && (!('studyBlocks' in data) || data.studyBlocks is list && data.studyBlocks.size() <= 200)
        && (!('weeklyHours' in data) || data.weeklyHours is map)
        && (!('weeklyQuestions' in data) || data.weeklyQuestions is map)
        && (!('weeklyReviews' in data) || data.weeklyReviews is map)
        && (!('createdAt' in data) || data.createdAt is string && data.createdAt.size() <= 50)
        && (!('examDate' in data) || data.examDate is string && data.examDate.size() <= 100)
        && (!('examName' in data) || data.examName is string && data.examName.size() <= 200);
    }


    // Error notes live in separate subcollections; validates each entry to
    // avoid growing the existing profile document or weakening owner isolation.
    function isValidErrorNote(data) {
      return data.keys().hasAll([
        'id', 'profileId', 'disciplineId', 'disciplineName',
        'topicId', 'topicName', 'questionRef', 'cause',
        'summary', 'rule', 'front', 'back', 'status',
        'createdAtMs', 'updatedAtMs'
      ])
      && data.keys().hasOnly([
        'id', 'profileId', 'disciplineId', 'disciplineName',
        'topicId', 'topicName', 'questionRef', 'cause',
        'summary', 'rule', 'front', 'back', 'status',
        'createdAtMs', 'updatedAtMs'
      ])
      && data.id is string && isValidId(data.id)
      && data.profileId is string && isValidId(data.profileId)
      && data.disciplineId is string && data.disciplineId.size() > 0 && data.disciplineId.size() <= 128
      && data.disciplineName is string && data.disciplineName.size() > 0 && data.disciplineName.size() <= 160
      && data.topicId is string && data.topicId.size() > 0 && data.topicId.size() <= 128
      && data.topicName is string && data.topicName.size() > 0 && data.topicName.size() <= 160
      && data.questionRef is string && data.questionRef.size() <= 240
      && data.cause in ['desconhecimento', 'confusao', 'interpretacao', 'desatencao', 'tempo', 'outro']
      && data.summary is string && data.summary.size() > 0 && data.summary.size() <= 1000
      && data.rule is string && data.rule.size() > 0 && data.rule.size() <= 2000
      && data.front is string && data.front.size() <= 500
      && data.back is string && data.back.size() <= 1000
      && data.status in ['aberto', 'revisado', 'arquivado']
      && data.createdAtMs is int && data.createdAtMs > 0
      && data.updatedAtMs is int && data.updatedAtMs >= data.createdAtMs;
    }

    // Match blocks for Collections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      
      // Updates: only allow modifying activeProfileId, reminders, name, or createdAt
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().email == existing().email &&
        incoming().diff(existing()).affectedKeys().hasOnly(['activeProfileId', 'reminders', 'name', 'createdAt'])
      );
      
      allow delete: if false;

      match /profiles/{profileId} {
        allow get, list: if isOwner(userId);
        
        allow create: if isOwner(userId) 
          && isValidId(profileId) 
          && isValidProfile(incoming()) 
          && incoming().id == profileId;
        
        allow update: if isOwner(userId) 
          && isValidId(profileId) 
          && isValidProfile(incoming()) && (
            incoming().id == existing().id &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 
              'disciplines', 
              'mockTests', 
              'exerciseLogs', 
              'activityLogs', 
              'studyBlocks', 
              'weeklyHours', 
              'weeklyQuestions', 
              'weeklyReviews',
              'examDate',
              'examName',
              'createdAt'
            ])
          );
        
        allow delete: if isOwner(userId) 
          && isValidId(profileId);

        match /errors/{errorId} {
          // A collection query does not bind a concrete errorId. Validate
          // errorId only on document-level get/create/update/delete.
          allow get: if isOwner(userId) && isValidId(profileId) && isValidId(errorId);
          allow list: if isOwner(userId) && isValidId(profileId);
          allow create: if isOwner(userId) && isValidId(profileId) && isValidId(errorId)
            && exists(/databases/$(database)/documents/users/$(userId)/profiles/$(profileId))
            && isValidErrorNote(incoming())
            && incoming().id == errorId && incoming().profileId == profileId;
          allow update: if isOwner(userId) && isValidId(profileId) && isValidId(errorId)
            && isValidErrorNote(incoming()) && incoming().id == existing().id
            && incoming().profileId == existing().profileId
            && incoming().createdAtMs == existing().createdAtMs;
          allow delete: if isOwner(userId) && isValidId(profileId) && isValidId(errorId);
        }
      }
    }
  }
}
